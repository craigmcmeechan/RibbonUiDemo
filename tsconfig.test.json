{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/test-harness.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".storybook/**/*.ts",
    "e2e/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "packages/*/src/**/*.stories.ts",
    "packages/*/src/**/*.stories.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "types/**/*.d.ts",
    "*.config.ts",
    "vitest.setup.ts"
  ],
  "references": [
    {
      "path": "./packages/ui"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ribbon-ui:schema:component:separator:1.0.0",
  "title": "SeparatorConfig",
  "description": "Serializable configuration for the decorative RibbonUI separator atom.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*$",
      "description": "Stable separator instance identifier."
    },
    "orientation": {
      "type": "string",
      "enum": ["vertical", "horizontal"],
      "default": "vertical",
      "description": "Divider axis: vertical separates side-by-side controls, horizontal stacks rows."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ribbon-ui:schema:component:menu-item:1.0.0",
  "title": "MenuItemConfig",
  "description": "Serializable configuration for the RibbonUI menu item primitive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*$",
      "description": "Stable menu item instance identifier."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Visible text and accessible name for the menu item."
    },
    "shortcut": {
      "type": "string",
      "description": "Optional display-only keyboard shortcut hint."
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the item is skipped by navigation and not activatable."
    }
  }
}

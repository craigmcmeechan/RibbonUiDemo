{
  "name": "ribbon-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11.14.0 <12"
  },
  "scripts": {
    "build": "pnpm --filter @ribbon-ui/ui build && pnpm --filter @ribbon-ui/editor-demo build && pnpm --filter @ribbon-ui/crm-workspace build",
    "build:ui": "pnpm --filter @ribbon-ui/ui build",
    "build:editor": "pnpm --filter @ribbon-ui/ui build && pnpm --filter @ribbon-ui/editor-demo build",
    "build:crm": "pnpm --filter @ribbon-ui/ui build && pnpm --filter @ribbon-ui/crm-workspace build",
    "dev:editor": "pnpm --filter @ribbon-ui/ui build && pnpm --filter @ribbon-ui/editor-demo dev",
    "dev:crm": "pnpm --filter @ribbon-ui/ui build && pnpm --filter @ribbon-ui/crm-workspace dev",
    "typecheck": "tsc --build --force --pretty false",
    "typecheck:ui": "tsc --build packages/ui/tsconfig.json --force --pretty false",
    "typecheck:editor": "tsc --build apps/editor-demo/tsconfig.json --force --pretty false",
    "typecheck:crm": "tsc --build apps/crm-workspace/tsconfig.json --force --pretty false",
    "schema:generate": "tsx scripts/schema/generate-schema-types.ts --write",
    "schema:check": "tsx scripts/schema/generate-schema-types.ts --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm schema:check",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "storybook": "storybook dev --port 6106 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "verify": "pnpm quality && pnpm build && pnpm test:coverage && pnpm storybook:build && pnpm test:storybook && pnpm test:e2e && pnpm test:visual"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "legacy-react": "npm:react@18.3.1",
    "legacy-react-dom": "npm:react-dom@18.3.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.6",
    "tsx": "4.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
